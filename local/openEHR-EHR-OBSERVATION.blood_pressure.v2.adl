		["fi"] = <
			items = <
				["at0000"] = <
					text = <"Verenpaine">
					description = <"Paikallisen valtimopaineen mittaustulos, joka toimii korvikkeena systeemisen verenkierron valtimopaineelle.  Termillä ”verenpaine” viitataan yleensä olkavarresta tehtävään olkavarsivaltimon paineen mittaustulokseen.">
