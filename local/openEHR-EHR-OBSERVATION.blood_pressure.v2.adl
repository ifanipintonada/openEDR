				["at0033"] = <
					text = <"Opmerking">
					description = <"Aanvullend opmerkingen over de meting, niet vastgelegd in andere velden.">
				>
				["at1059"] = <
					text = <"Klinische interpretatie">
					description = <"Eén woord, zin of korte beschrijving die de klinische betekenis van de bloeddrukmeting weergeeft.">
				>
			>
		>
		["ru"] = <
			items = <
				["at0000"] = <
					text = <"АД">
					description = <"Локальное измерение артериального давления, которое является суррогатом артериального давления в системном кровотоке. Как правило, термин относится к давления плечевой артерии на предплечье.
">
