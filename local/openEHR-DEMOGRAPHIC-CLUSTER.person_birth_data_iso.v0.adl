definition
	CLUSTER[at0000] matches {    -- Birth data
		items cardinality matches {1..*; ordered} matches {
			ELEMENT[at0001] matches {    -- Birth date
				value matches {
					DV_DATE matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Country of birth
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
		}
	}

