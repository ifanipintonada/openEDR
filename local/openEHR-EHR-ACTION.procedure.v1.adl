					description = <"*A clinical activity carried out for screening, investigative, diagnostic, curative, therapeutic, evaluative or palliative purposes.(en)">
				>
				["at0001"] = <
					text = <"*Tree(en)">
					description = <"*@ internal @(en)">
				>
				["at0002"] = <
					text = <"*Procedure name(en)">
					description = <"*Identification of the procedure by name.(en)">
					comment = <"*Coding of the specific procedure with a terminology is preferred, where possible.(en)">
				>
				["at0049"] = <
					text = <"*Description(en)">
					description = <"*Narrative description about the procedure, as appropriate for the pathway step.(en)">
					comment = <"*For example: description about the performance and findings from the the procedure, the aborted attempt or the cancellation of the procedure.(en)">
				>
				["at0066"] = <
