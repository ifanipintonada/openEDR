	>

definition
	EVALUATION[at0000] matches {    -- Alcohol consumption summary
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0089] occurrences matches {0..1} matches {    -- Overall status
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Current drinker
									at0005,    -- Former drinker
									at0006]    -- Lifetime non-drinker
								}
							}
						}
					}
					ELEMENT[at0043] occurrences matches {0..1} matches {    -- Overall description
						value matches {
							DV_TEXT matches {*}
						}
					}
					CLUSTER[at0064] occurrences matches {0..*} matches {    -- Per episode
						items cardinality matches {1..*; unordered} matches {
							CLUSTER[at0029] occurrences matches {0..*} matches {    -- Per type
								name matches {
									DV_TEXT matches {*}
								}
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0108] matches {    -- Type
										value matches {
											DV_TEXT matches {*}
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0115,    -- Beer
													at0116,    -- Wine
													at0117,    -- Cider
													at0118,    -- Mead
													at0119,    -- Pulque
													at0120,    -- Spirits
													at0121]    -- Fortified wine
												}
											}
										}
									}
									ELEMENT[at0053] occurrences matches {0..1} matches {    -- Description
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0111] occurrences matches {0..1} matches {    -- Typical consumption quantity
										value matches {
											C_DV_QUANTITY <
												
												list = <
													["1"] = <
														units = <"1/d">
														magnitude = <|>=0.0|>
														precision = <|1|>
													>
													["2"] = <
														units = <"1/wk">
														magnitude = <|>=0.0|>
														precision = <|1|>
													>
													["3"] = <
														units = <"1/mo">
														magnitude = <|>=0.0|>
														precision = <|1|>
													>
												>
											>
										}
									}
									ELEMENT[at0069] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
							ELEMENT[at0052] occurrences matches {0..1} matches {    -- Status
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0061,    -- Current drinker
											at0091]    -- Non-drinker
										}
									}
								}
							}
							ELEMENT[at0030] occurrences matches {0..1} matches {    -- Pattern
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0083,    -- Daily
											at0084]    -- Non-daily
										}
									}
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0013] occurrences matches {0..1} matches {    -- Start date
								value matches {
									DV_DATE matches {*}
								}
							}
							ELEMENT[at0097] occurrences matches {0..1} matches {    -- Binge drinking frequency
								value matches {
									C_DV_QUANTITY <
										
										list = <
											["1"] = <
												units = <"1/wk">
												magnitude = <|0.0..7.0|>
												precision = <|0|>
											>
											["2"] = <
												units = <"1/mo">
												magnitude = <|0.0..31.0|>
												precision = <|0|>
											>
											["3"] = <
												units = <"1/a">
												magnitude = <|0.0..365.0|>
												precision = <|0|>
											>
										>
									>
									DV_INTERVAL<DV_QUANTITY> matches {
										lower matches {
											C_DV_QUANTITY <
												
												list = <
													["1"] = <
														units = <"1/wk">
														magnitude = <|0.0..7.0|>
														precision = <|0|>
													>
													["2"] = <
														units = <"1/mo">
														magnitude = <|0.0..31.0|>
														precision = <|0|>
													>
													["3"] = <
														units = <"1/a">
														magnitude = <|0.0..365.0|>
														precision = <|0|>
													>
												>
											>
										}
										upper matches {
											C_DV_QUANTITY <
												
												list = <
													["1"] = <
														units = <"1/wk">
														magnitude = <|0.0..7.0|>
														precision = <|0|>
													>
													["2"] = <
														units = <"1/mo">
														magnitude = <|0.0..31.0|>
														precision = <|0|>
													>
													["3"] = <
														units = <"1/a">
														magnitude = <|0.0..365.0|>
														precision = <|0|>
													>
												>
											>
										}
									}
								}
							}
							ELEMENT[at0113] occurrences matches {0..1} matches {    -- Binge drinking description
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0110] occurrences matches {0..1} matches {    -- Alcohol free days
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::382]>
										list = <
											["1"] = <
												units = <"1/wk">
												magnitude = <|0.0..<7.0|>
												precision = <|0|>
											>
											["2"] = <
												units = <"1/mo">
												magnitude = <|0.0..<31.0|>
												precision = <|0|>
											>
										>
									>
								}
							}
							ELEMENT[at0112] occurrences matches {0..1} matches {    -- Episode description
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0087] occurrences matches {0..1} matches {    -- Episode comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {    -- Overall quit date
						value matches {
							DV_DATE matches {*}
						}
					}
					ELEMENT[at0019] occurrences matches {0..1} matches {    -- Overall comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Alcohol consumption summary">
					description = <"Summary or persistent information about the typical alcohol consumption of an individual.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Current drinker">
					description = <"Individual is a current consumer of alcohol.">
				>
				["at0005"] = <
					text = <"Former drinker">
					description = <"Individual has previously consumed alcohol but is not a current drinker.">
				>
				["at0006"] = <
					text = <"Lifetime non-drinker">
					description = <"Individual has never consumed alcohol.">
				>
				["at0013"] = <
					text = <"Start date">
					description = <"Date when this episode commenced.">
					comment = <"Can be a partial date, for example, only a year.">
				>
				["at0016"] = <
					text = <"Overall quit date">
					description = <"The date when the individual last ceased consuming alcohol of any type.">
					comment = <"Can be a partial date, for example, only a year. This date could be used by decision support guidance to determine if the individual is at risk of relapse, for example in the first 12 months since quitting.">
				>
				["at0019"] = <
					text = <"Overall comment">
					description = <"Additional narrative about all alcohol consumption that has not been captured in other fields.">
				>
				["at0029"] = <
					text = <"Per type">
					description = <"Details about consumption of a specified type of alcohol.">
				>
				["at0030"] = <
					text = <"Pattern">
					description = <"The typical pattern of consumption of alcohol.">
					comment = <"The typical pattern of use can be made more granular by coding with a terminology or a local value set in a template.">
				>
				["at0043"] = <
					text = <"Overall description">
					description = <"Narrative summary about the individual's overall alcohol consumption pattern and history.">
					comment = <"Use this data element to record a narrative description of alcohol drinking habits for this individual or to incorporate unstructured alcohol drinking information from existing or legacy clinical systems into an archetyped format.">
				>
				["at0052"] = <
					text = <"Status">
					description = <"Statement about current alcohol drinking behaviour.">
				>
				["at0053"] = <
					text = <"Description">
					description = <"Narrative summary about alcohol consumption for the specified type of alcohol.">
				>
				["at0061"] = <
					text = <"Current drinker">
					description = <"Individual consumed alcohol during this period.">
				>
				["at0064"] = <
					text = <"Per episode">
					description = <"Details about a discrete period of time with a consistent pattern of typical consumption.">
				>
				["at0069"] = <
					text = <"Comment">
					description = <"Additional narrative about consumption of the specified type of alcohol, not captured in other fields.">
				>
				["at0083"] = <
					text = <"Daily">
					description = <"Consuming alcoholic beverage at least once every day.">
				>
				["at0084"] = <
					text = <"Non-daily">
					description = <"Not consuming alcoholic beverage every day.">
				>
				["at0087"] = <
					text = <"Episode comment">
					description = <"Additional narrative about alcohol consumption during the specified episode, not captured in other fields.">
					comment = <"For example: alcohol consumed as a hangover remedy eg 'hair of the dog'.">
				>
				["at0089"] = <
					text = <"Overall status">
					description = <"Statement about current consumption for all types of alcohol.">
				>
				["at0091"] = <
					text = <"Non-drinker">
					description = <"Individual has not consumed alcohol during this episode.">
				>
				["at0097"] = <
					text = <"Binge drinking frequency">
					description = <"The individual's typical frequency of heavy drinking over a short period of time with the intent of becoming intoxicated.">
				>
				["at0108"] = <
					text = <"Type">
					description = <"The name of the specific type or grouping of alcohol.">
					comment = <"Use of the coded text option is preferrable when possible. Alternatively, it's possible to use a local valueset or terminologi to record specific types of alcoholic beverages. For example: red or white wine; brandy or whisky; normal or low alcohol beer; or denatured alcohol (methylated spirits) as a specific form of rectified spirits.">
				>
				["at0110"] = <
					text = <"Alcohol free days">
					description = <"The number of days where no alcohol was consumed in the specified period.">
				>
				["at0111"] = <
					text = <"Typical consumption quantity">
					description = <"Estimate of number of standard drinks of the specified type of alcohol consumed.">
					comment = <"The definition of an Alcohol unit can be recorded in the Protocol.">
				>
				["at0112"] = <
					text = <"Episode description">
					description = <"Narrative summary about the individual's overall pattern of alcohol consumption during the specified episode.">
					comment = <"For example: details about binge drinking pattern.">
				>
				["at0113"] = <
					text = <"Binge drinking description">
					description = <"Narrative description about the individual's typical pattern of binge drinking.">
				>
				["at0115"] = <
					text = <"Beer">
					description = <"Fermented beverage made from grain mash.">
				>
				["at0116"] = <
					text = <"Wine">
					description = <"Fermented beverage made from grapes and sometimes other fruits.">
				>
				["at0117"] = <
					text = <"Cider">
					description = <"Fermented beverage made from any fruit juice.">
				>
				["at0118"] = <
					text = <"Mead">
					description = <"Fermented beverage made from honey, sometimes with various fruits spices, grains or hops.">
				>
				["at0119"] = <
					text = <"Pulque">
					description = <"Fermented beverage made from 'honey water\" of cacti.">
				>
				["at0120"] = <
					text = <"Spirits">
					description = <"Fermented beverage made by a distillation process. Usually has an alcohol content >20%. Includes liquers, cocktails and rectified spirits.">
				>
				["at0121"] = <
					text = <"Fortified wine">
					description = <"Wine with added spirits.">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Alkoholanamnese">
					description = <"Sammendrag eller detaljer om et individs tidligere og nåværende bruk av alkohol.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Nåværende bruker">
					description = <"Individet drikker alkohol.">
				>
				["at0005"] = <
					text = <"Tidligere bruker">
					description = <"Individet har drukket alkohol tidligere, men drikker ikke nå.">
				>
				["at0006"] = <
					text = <"Aldri brukt">
					description = <"Individet har aldri drukket alkohol.">
				>
				["at0013"] = <
					text = <"*Start date (en)">
					description = <"Dato da episoden startet.">
					comment = <"Kan være en deldato, for eksempel kun årstall.">
				>
				["at0016"] = <
					text = <"Overordnet sluttdato">
					description = <"Datoen da individet sist brukte en hvilken som helst type alkohol.">
					comment = <"Kan være en deldato, for eksempel årstall. Denne datoen kan brukes av beslutningsstøttesystemer for å beregne om individet er i faresonen for tilbakefall, for eksempel i løpet av de første 12 månedene etter å ha sluttet.">
				>
				["at0019"] = <
					text = <"Overordnet kommentar">
					description = <"Ytterligere fritekst om all bruk av alkohol, og som ikke er fanget i andre element.">
				>
				["at0029"] = <
					text = <"Per type">
					description = <"Detaljer om bruk av spesifikk type alkohol.">
				>
				["at0030"] = <
					text = <"Mønster">
					description = <"Typisk bruksmønster for perioden.">
					comment = <"Bruksmønsteret kan registreres mer detaljert ved å benytte en terminologi eller et lokalt verdisett i en templat.">
				>
				["at0043"] = <
					text = <"Overordnet beskrivelse">
					description = <"Oppsummering i fritekst om et individs overordnede mønster og historie knyttet til alkoholinntak.">
					comment = <"Bruk dette elementet for å registrere en beskrivelse i fritekst om drikkevaner for dette individet, eller for å overføre til arketypeformat ustrukturert informasjon om drikkevaner fra et eksisterende eller tidligere brukt klinisk system.">
				>
				["at0052"] = <
					text = <"Status">
					description = <"Utsagn om nåværende atferd for alkoholinntak.">
				>
				["at0053"] = <
					text = <"Beskrivelse">
					description = <"Oppsummering i fritekst om drikkeatferd for den spesifiserte typen alkoholholdig drikke.">
				>
				["at0061"] = <
					text = <"Nåværende bruker">
					description = <"Individet har inntatt alkohol i denne episoden.">
				>
				["at0064"] = <
					text = <"Per episode">
					description = <"Detaljer om en avgrenset eller pågående episode med et vedvarende mønster i drikkevaner.">
				>
				["at0069"] = <
					text = <"Kommentar">
					description = <"Ytterligere fritekst om bruk av den spesifiserte typen alkoholholdig drikke, og som ikke er registrert i andre element.">
				>
				["at0083"] = <
					text = <"Daglig">
					description = <"Individet drikker alkohol minst en gang per dag.">
				>
				["at0084"] = <
					text = <"Ikke daglig">
					description = <"Individet drikker ikke alkohol daglig.">
				>
				["at0087"] = <
					text = <"Kommentarer til episoden">
					description = <"Ytterligere fritekst om episoden med drikking av alkohol, og som ikke er fanget i andre element.">
					comment = <"For eksempel om individet \"reparerer\".">
				>
				["at0089"] = <
					text = <"Overordnet status">
					description = <"Utsagn om nåværende atferd og bruk for alle typer alkohol.">
				>
				["at0091"] = <
					text = <"Aldri brukt">
					description = <"Individet har ikke drukket alkohol i løpet av denne episoden.">
				>
				["at0097"] = <
					text = <"Frekvens for episodisk høyt forbruk">
					description = <"Individets frekvens for episodisk høyt forbruk over korte tidsperioder, der formålet er å bli full, mao hvor ofte har individet \"fyllekuler\".">
				>
				["at0108"] = <
					text = <"Type">
					description = <"Navnet på den spesifikke typen eller gruppen av alkohol.">
					comment = <"Bruk helst det forhåndsdefinerte verdisettet der det er mulig. Alternativt kan man bruke et lokalt verdisett eller en terminologi for å registrere spesifikke type alkoholholdige drikker, for eksempel rød eller hvit vin, brandy eller whisky, vanlig øl eller lettøl, eller denaturert alkohol som rødsprit som en spesifikk type sprit.">
				>
				["at0110"] = <
					text = <"Alkoholfrie dager">
					description = <"Antall dager individet ikke drakk alkohol i den spesifiserte perioden.">
				>
				["at0111"] = <
					text = <"*Typical consumption quantity (en)">
					description = <"Estimat på antall alkoholenheter av den spesifiserte typen alkohol som ble drukket.">
					comment = <"Definisjon på alkoholenhet kan gjøres i protokolldelen av arketypen.">
				>
				["at0112"] = <
					text = <"Beskrivelse av episoden">
					description = <"Oppsummerende beskrivelse i fritekst om individets overordnede drikkemønster innenfor den angitte perioden.">
					comment = <"For eksempel detaljer om mønster for stordrikking eller fyllekuler.">
				>
				["at0113"] = <
					text = <"Beskrivelse av episodisk høyt forbruk">
					description = <"Beskrivelse i fritekst om individets typiske mønster for episodisk høyt forbruk.">
				>
				["at0115"] = <
					text = <"Øl">
					description = <"Gjæret alkoholholdig drikke brygget på korn.">
				>
				["at0116"] = <
					text = <"Vin">
					description = <"Gjæret alkoholholdig drikke laget av druesaft eller noen ganger av annen frukt.">
				>
				["at0117"] = <
					text = <"Sider">
					description = <"Gjæret alkoholholdig drikk laget av råsaft fra epler eller annen frukt.">
				>
				["at0118"] = <
					text = <"Mjød">
					description = <"Gjæret alkoholholdig drikk laget av honning, vann og gjær. Noen ganger med tilsatt krydder, som mjødurt.">
				>
				["at0119"] = <
					text = <"Pulque">
					description = <"Gjæret alkoholholdig drikk laget av sevje fra agaveplanten, for eksempel tequilla.">
				>
				["at0120"] = <
					text = <"Brennevin (Sprit)">
					description = <"Gjæret alkoholholdig drikk laget ved destillasjon. Vanligvis med en alkoholprosent > 20%. Omfatter også likører, coctails og teknisk etanol.">
				>
				["at0121"] = <
					text = <"Sterkvin">
					description = <"Vin som er tilsatt brennevin. Tidligere kalt hetvin.">
				>
			>
		>
		["sv"] = <
			items = <
				["at0000"] = <
					text = <"Sammanfattning av konsumtion av alkohol">
					description = <"Sammanfattning eller beständig information om den enskilda personens typiska alkoholkonsumtion.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Dricker alkohol">
					description = <"Individen är konsument av alkohol">
				>
				["at0005"] = <
					text = <"Har slutat dricka alkohol">
					description = <"Individen har tidigare konsumerat alkohol men har slutat.">
				>
				["at0006"] = <
					text = <"Har aldrig druckit alkohol">
					description = <"Individen har aldrig konsumerat alkohol">
				>
				["at0013"] = <
					text = <"*Start date (en)">
					description = <"Datum när den här episoden startade.">
					comment = <"Kan vara del av ett datum, till exempel bara ett år.">
				>
				["at0016"] = <
					text = <"Övergripande slutdatum">
					description = <"Datum då individen helt slutade använda alkohol, oavsett typ.">
					comment = <"Kan vara ett del av datum, till exempel bara ett årtal. Detta datum kan användas av för att avgöra om individen är i riskzonen för återfall, till exempel under de första 12 månaderna sedan hen slutade.">
				>
				["at0019"] = <
					text = <"Övergripande kommentar">
					description = <"Ytterligare beskrivande information om all alkoholanvändning som inte har fångats i andra fält.">
				>
				["at0029"] = <
					text = <"Per typ">
					description = <"Detaljer om konsumtion av en viss typ av alkoholhaltig dryck.">
				>
				["at0030"] = <
					text = <"Mönster">
					description = <"Det typiska mönstret för konsumtion av alkohol.">
					comment = <"Det typiska mönstret för konsumtion kan göras mer granulärt genom kodning med en terminologi eller ett lokalt värde som anges i en mall.">
				>
				["at0043"] = <
					text = <"Övergripande beskrivning">
					description = <"Beskrivande sammanfattning om individens övergripande alkoholvanor och historik.">
					comment = <"Använd det här fältet endast för att ge en beskrivande sammanfattning om de strukturerade fälten inte ger en adekvat bild av individens alkoholvanor, eller att införliva ostrukturerad information om alkoholvanor från befintliga eller gamla vård-IT-system till ett arketyp-baserade system.">
				>
				["at0052"] = <
					text = <"Status">
					description = <"Uttalande om aktuell alkoholvana.">
				>
				["at0053"] = <
					text = <"Beskrivning">
					description = <"Beskrivande sammanfattning om alkohol konsumtion för det specificerade typen av alkohol.">
				>
				["at0061"] = <
					text = <"Dricker alkohol">
					description = <"Individen har konsumerat alkohol under denna episod.">
				>
				["at0064"] = <
					text = <"Per episod">
					description = <"Detaljer om en separat konsumtionstid med ett konsekvent mönster av typisk förbrukning.">
				>
				["at0069"] = <
					text = <"Kommentar">
					description = <"Ytterligare beskrivande information om den specificerat typ av alkohol som inte är fångat i andra fält.">
				>
				["at0083"] = <
					text = <"Dagligen">
					description = <"Konsumerar alkoholhaltig dryck minst en gång varje dag.">
				>
				["at0084"] = <
					text = <"Inte dagligen">
					description = <"Konsumerar inte alkoholhaltig dryck varje dag.">
				>
				["at0087"] = <
					text = <"Episodkommentar">
					description = <"Ytterligare beskrivande information om alkoholkonsumtion under det angivna episoden som inte är fångat i andra fält.">
					comment = <"Till exempel: alkohol som förbrukas som botemedel för baksmälla, t.ex. återställare">
				>
				["at0089"] = <
					text = <"Övergripande status">
					description = <"Beskrivning av aktuellt konsumtion för alla typer av alkohol.">
				>
				["at0091"] = <
					text = <"Dricker inte alkohol">
					description = <"Individen har inte konsumerat alkohol under denna episod.">
				>
				["at0097"] = <
					text = <"Berusningsdrickande frekvens">
					description = <"Individens typiska frekvens av stort alkoholintag, med avsikt att bli berusad, under en kort tidsperiod.">
				>
				["at0108"] = <
					text = <"Typ">
					description = <"Namnet på den specifika typen eller grupp av alkoholdryck.">
					comment = <"Använd det kodade textalternativet (coded text) när det är möjligt. Alternativt är det möjligt att använda ett lokalt kodverk eller terminologisystem för att registrera specifika typer av alkoholhaltiga drycker. Till exempel: rött eller vitt vin; brandy eller whisky; starköl eller lättöl; eller denaturerad alkohol (ex rödsprit) eller annan form av renad sprit.">
				>
				["at0110"] = <
					text = <"Alkoholfria dagar">
					description = <"Antalet dagar när ingen alkohol konsumerats under den angivna episoden.">
				>
				["at0111"] = <
					text = <"*Typical consumption quantity (en)">
					description = <"*Estimate of number of standard drinks of the specified type of alcohol consumed. (en)">
					comment = <"Definitionen av en alkoholenhet kan registreras i protokollet.">
				>
				["at0112"] = <
					text = <"Episodbeskrivning">
					description = <"Beskrivande sammanfattning om individens övergripande alkoholvanor under den angivna episoden.">
					comment = <"Till exempel: detaljer om mönster för berusningsdrickande.">
				>
				["at0113"] = <
					text = <"Berusningsdrickandebeskrivning">
					description = <"Beskrivande sammanfattning om individens typiska mönster av berusningsdrickande.">
				>
				["at0115"] = <
					text = <"Öl">
					description = <"Jäst dryck gjord av spannmålsmäsk.">
				>
				["at0116"] = <
					text = <"Vin">
					description = <"Jäst dryck gjord av druvor och ibland andra frukter.">
				>
				["at0117"] = <
					text = <"Cider">
					description = <"Jäst dryck gjord av fruktjuice.">
				>
				["at0118"] = <
					text = <"Mjöd">
					description = <"Jäst dryck gjord av honung, ibland med olika frukter, kryddor, spannmål eller humle.">
				>
				["at0119"] = <
					text = <"Pulque">
					description = <"Jäst dryck gjord på växtsaft från arter i agavesläktet.">
				>
				["at0120"] = <
					text = <"Sprit">
					description = <"Jäst dryck gjord genom en destillationsprocess. Har vanligtvis en alkoholhalt >20%.">
				>
				["at0121"] = <
					text = <"Starkvin">
					description = <"Vin med tillsatt sprit, till exempel portvin, sherry, madeira och marsala.">
				>
			>
		>
		["de"] = <
			items = <
				["at0000"] = <
					text = <"Zusammenfassung des Alkoholkonsums">
					description = <"Zusammenfassende oder fortdauernde Informationen über den typischen Alkoholkonsum einer Person.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Derzeitiger Trinker">
					description = <"Die Person ist aktuell Alkoholkonsument.">
				>
				["at0005"] = <
					text = <"Ehemaliger Trinker">
					description = <"Die Person hat früher Alkohol konsumiert, ist aber aktuell kein Alkoholkonsument.">
				>
				["at0006"] = <
					text = <"Lebenslanger Nicht-Konsument">
					description = <"Die Person hat niemals Alkohol konsumiert.">
				>
				["at0013"] = <
					text = <"*Start date (en)">
					description = <"Datum, an dem die Episode begann.">
					comment = <"Kann ein Teildatum sein, z.B. ein Jahr.">
				>
				["at0016"] = <
					text = <"Allgemeiner Zeitpunkt des Aufhörens">
					description = <"Das Datum, an dem die Person zuletzt den Konsum von Alkohol jeglicher Art eingestellt hat.">
					comment = <"Ein Teildatum kann z.B. nur ein Jahr sein. Dieses Datum könnte als Entscheidungshilfe verwendet werden, um festzustellen, ob die Person rückfallgefährdet ist, z.B. in den ersten 12 Monaten nach dem Aufhören.">
				>
				["at0019"] = <
					text = <"Allgemeiner Kommentar">
					description = <"Zusätzliche Informationen über den Konsum des angegebenen alkoholischen Getränks, die nicht in anderen Feldern erfasst wurde.">
				>
				["at0029"] = <
					text = <"Pro Typ">
					description = <"Details über den Konsum einer bestimmten Art von alkoholischen Getränken.">
				>
				["at0030"] = <
					text = <"Muster des Alkoholkonsums">
					description = <"Das typische Muster des Alkoholkonsums.
">
					comment = <"Das typische Muster des Alkoholkonsums kann durch die Codierung mit einer Terminologie oder einem lokalen Valueset in einem Template präzisiert werden.">
				>
				["at0043"] = <
					text = <"Allgemeine Beschreibung">
					description = <"Zusammenfassung des gesamten Alkoholkonsumverhaltens und der Vorgeschichte der Person.">
					comment = <"Verwenden Sie dieses Datenelement, um eine Beschreibung der Alkoholtrinkgewohnheiten für diese Person aufzuzeichnen oder um unstrukturierte Informationen über den Alkoholkonsum aus bestehenden oder älteren klinischen Systemen in ein archetypisches Format zu integrieren.">
				>
				["at0052"] = <
					text = <"Status">
					description = <"Information zum aktuellen Alkoholkonsumverhalten.">
				>
				["at0053"] = <
					text = <"Beschreibung">
					description = <"Zusammenfassung des Alkoholkonsumverhaltens für die angegebene Art von Getränk.">
				>
				["at0061"] = <
					text = <"Derzeitiger Trinker">
					description = <"Die Person konsumierte Alkohol in dieser Episode.">
				>
				["at0064"] = <
					text = <"Pro Episode">
					description = <"Angaben zu einem abgegrenzten Zeitraum des Konsums mit einem konsistenten Konsumverhalten.">
				>
				["at0069"] = <
					text = <"Kommentar">
					description = <"Zusätzliche Informationen über den Konsum des angegebenen alkoholischen Getränks, die nicht in anderen Feldern erfasst wurde.">
				>
				["at0083"] = <
					text = <"Täglich">
					description = <"Das angegebene alkoholische Getränk wird mindestens einmal täglich konsumiert.">
				>
				["at0084"] = <
					text = <"Nicht-täglich">
					description = <"Das alkoholische Getränk wird nicht jeden Tag konsumiert.">
				>
				["at0087"] = <
					text = <"Kommentar zur Episode">
					description = <"Zusätzliche Kommentare über den Alkoholkonsum während der angegebenen Episode, die nicht in anderen Feldern erfasst wurde.">
					comment = <"Zum Beispiel: Alkohol, der als Katermittel konsumiert wird, z.B. \"Konterbier\".">
				>
				["at0089"] = <
					text = <"Allgemeiner Status">
					description = <"Information zum aktuellen Alkoholkonsumverhalten für alle Arten von Alkohol.">
				>
				["at0091"] = <
					text = <"Nicht-Konsument">
					description = <"Die Person hat keinen Alkohol in dieser Episode konsumiert.">
				>
				["at0097"] = <
					text = <"Frequenz des Alkoholkonsums">
					description = <"Die typische Häufigkeit von starkem Trinken über einen kurzen Zeitraum mit der Absicht, betrunken zu werden.">
				>
				["at0108"] = <
					text = <"Typ">
					description = <"Der Name des spezifischen Typs oder Gruppe von Alkohol">
					comment = <"Die Verwendung der Option \"CodedText\" ist nach Möglichkeit vorzuziehen. Alternativ ist es möglich, mit einem lokalen Valueset oder einer Terminologie bestimmte Arten von alkoholischen Getränken zu erfassen. Zum Beispiel: Rot- oder Weißwein; Brandy oder Whisky; normales oder alkoholreduziertes Bier; oder denaturierter Alkohol (methylierter Alkohol) als eine bestimmte Form von rektifiziertem Alkohol.

">
				>
				["at0110"] = <
					text = <"Alkoholfreie Tage">
					description = <"Die Anzahl der Tage, an denen kein Alkohol in der spezifizierten Episode konsumiert wurde.">
				>
				["at0111"] = <
					text = <"*Typical consumption quantity (en)">
					description = <"*Estimate of number of standard drinks of the specified type of alcohol consumed. (en)">
					comment = <"Die Definition von Alkoholeinheiten kann im Protokoll aufgezeichnet werden.">
				>
				["at0112"] = <
					text = <"Beschreibung der Episode">
					description = <"Beschreibung des Gesamtmusters des Alkoholkonsums der Person während der angegebenen Episode.">
					comment = <"Zum Beispiel: Details über Alkoholexzesse.">
				>
				["at0113"] = <
					text = <"Beschreibung des Alkoholexzesses">
					description = <"Beschreibung des typischen Musters eines Alkoholexzesses einer Person.">
				>
				["at0115"] = <
					text = <"Bier">
					description = <"Fermentiertes Getränk aus Getreidemaische.">
				>
				["at0116"] = <
					text = <"Wein">
					description = <"Fermentiertes Getränk aus Trauben und manchmal auch anderen Früchten.">
				>
				["at0117"] = <
					text = <"Cider">
					description = <"Fermentiertes Getränk aus einer beliebigen Art Fruchtsaft.">
				>
				["at0118"] = <
					text = <"Met">
					description = <"Fermentiertes Getränk aus Honig, manchmal mit verschiedenen Fruchtgewürzen, Getreide oder Hopfen.">
				>
				["at0119"] = <
					text = <"Agavenwein">
					description = <"Fermentiertes Getränk aus Honigwasser von Kakteen.">
				>
				["at0120"] = <
					text = <"Spirituosen">
					description = <"Fermentiertes Getränk, hergestellt durch ein Destillationsverfahren. Hat in der Regel einen Alkoholgehalt von >20%. Umfasst Liköre, Cocktails und rektifizierte Spirituosen.">
				>
				["at0121"] = <
					text = <"Likörwein">
					description = <"Wein mit hinzugefügten Spirituosen.">
				>
			>
		>
		["fr"] = <
			items = <
				["at0000"] = <
					text = <"Résumé de la consommation d'alcool">
					description = <"Informations sommaires ou persistantes sur la consommation d'alcool typique d'un individu.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Buveur actuel">
					description = <"L'individu est un consommateur actuel d'alcool.">
				>
				["at0005"] = <
					text = <"Ancien buveur">
					description = <"L'individu a déjà consommé de l'alcool mais n'est pas un consommateur actuel.">
				>
				["at0006"] = <
					text = <"Non-buveur à vie">
					description = <"L'individu n'a jamais consommé d'alcool.">
				>
				["at0013"] = <
					text = <"*Start date (en)">
					description = <"Date à laquelle cet épisode a commencé.">
					comment = <"Il peut s'agir d'une date partielle, par exemple, seulement une année.">
				>
				["at0016"] = <
					text = <"Date globale d'arrêt">
					description = <"Date globale d'arrêt">
					comment = <"Il peut s'agir d'une date partielle, par exemple, seulement un an. Cette date pourrait être utilisée par les guides d'aide à la décision pour déterminer si la personne risque de rechuter, par exemple dans les 12 premiers mois depuis qu'elle a arrêté de fumer.">
				>
				["at0019"] = <
					text = <"Commentaire général">
					description = <"Récit supplémentaire sur toute la consommation d'alcool qui n'a pas été saisie dans d'autres champs.">
				>
				["at0029"] = <
					text = <"Par type">
					description = <"Détails sur la consommation d'un type d'alcool spécifié.">
				>
				["at0030"] = <
					text = <"Schéma">
					description = <"Le schéma type de consommation d'alcool.">
					comment = <"Le modèle d'utilisation typique peut être rendu plus granulaire en codant avec une terminologie ou une valeur locale définie dans un modèle.">
				>
				["at0043"] = <
					text = <"Description générale">
					description = <"Résumé narratif sur les habitudes et les antécédents de consommation d'alcool de l'individu.">
					comment = <"Utilisez cet élément de données pour enregistrer une description narrative des habitudes de consommation d'alcool de cette personne ou pour incorporer des informations non structurées sur la consommation d'alcool provenant de systèmes cliniques existants ou hérités dans un format archétypal.">
				>
				["at0052"] = <
					text = <"Statut">
					description = <"Déclaration sur le comportement actuel en matière de consommation d'alcool.">
				>
				["at0053"] = <
					text = <"Description">
					description = <"Résumé narratif sur la consommation d'alcool pour le type d'alcool spécifié.">
				>
				["at0061"] = <
					text = <"Buveur actuel">
					description = <"L'individu a consommé de l'alcool pendant cette période.">
				>
				["at0064"] = <
					text = <"Par épisode">
					description = <"Détails sur une période de temps discrète avec un schéma de consommation typique cohérent.">
				>
				["at0069"] = <
					text = <"Commentaire">
					description = <"Exposé supplémentaire sur la consommation du type d'alcool spécifié, non saisi dans d'autres champs.">
				>
				["at0083"] = <
					text = <"Quotidiennement">
					description = <"Consommation d'une boisson alcoolisée au moins une fois par jour.">
				>
				["at0084"] = <
					text = <"Non quotidien">
					description = <"Ne pas consommer de boissons alcoolisées tous les jours.">
				>
				["at0087"] = <
					text = <"Commentaire de l'épisode">
					description = <"Un récit supplémentaire sur la consommation d'alcool pendant l'épisode spécifié, qui n'est pas saisi dans d'autres champs.">
					comment = <"Par exemple : l'alcool consommé comme remède contre la gueule de bois.">
				>
				["at0089"] = <
					text = <"Situation générale">
					description = <"Déclaration sur la consommation actuelle pour tous les types d'alcool.">
				>
				["at0091"] = <
					text = <"Non-buveur">
					description = <"L'individu n'a pas consommé d'alcool pendant cet épisode.">
				>
				["at0097"] = <
					text = <"Fréquence de consommation excessive">
					description = <"Fréquence typique de la consommation excessive d'alcool sur une courte période avec l'intention de s'intoxiquer.">
				>
				["at0108"] = <
					text = <"Type">
					description = <"Le nom du type ou du groupe spécifique d'alcool.">
					comment = <"Il est préférable d'utiliser l'option de texte codé lorsque cela est possible. Sinon, il est possible d'utiliser un ensemble de valeurs ou des terminologies locales pour enregistrer des types spécifiques de boissons alcoolisées. Par exemple : vin rouge ou blanc ; brandy ou whisky ; bière normale ou faiblement alcoolisée ; ou alcool dénaturé (alcool méthylique) comme forme spécifique de spiritueux rectifiés.">
				>
				["at0110"] = <
					text = <"Journées sans alcool">
					description = <"Le nombre de jours pendant lesquels aucun alcool n'a été consommé au cours de la période spécifiée.">
				>
				["at0111"] = <
					text = <"*Typical consumption quantity (en)">
					description = <"*Estimate of number of standard drinks of the specified type of alcohol consumed. (en)">
					comment = <"La définition d'une unité d'alcool peut être enregistrée dans le protocole.">
				>
				["at0112"] = <
					text = <"Description de l'épisode">
					description = <"Résumé narratif sur les habitudes générales de consommation d'alcool de l'individu pendant l'épisode spécifié.">
					comment = <"Résumé narratif sur les habitudes générales de consommation d'alcool de l'individu pendant l'épisode spécifié.">
				>
				["at0113"] = <
					text = <"Description de la consommation excessive">
					description = <"Description narrative des habitudes typiques de consommation excessive d'alcool de l'individu.">
				>
				["at0115"] = <
					text = <"Bière">
					description = <"Boisson fermentée à base de purée de céréales.">
				>
				["at0116"] = <
					text = <"Vin">
					description = <"Boisson fermentée à base de raisins et parfois d'autres fruits.">
				>
				["at0117"] = <
					text = <"Cidre">
					description = <"Boisson fermentée à base de n'importe quel Cidre de fruit.">
				>
				["at0118"] = <
					text = <"Hydromel">
					description = <"Hydromel">
				>
				["at0119"] = <
					text = <"Pulque">
					description = <"Boisson fermentée à base d'\"eau de miel\" de cactus.">
				>
				["at0120"] = <
					text = <"Spiritueux">
					description = <"Spiritueux">
				>
				["at0121"] = <
					text = <"Vin fortifié">
					description = <"Vin additionné de spiritueux.">
				>
			>
		>
		["nl"] = <
			items = <
				["at0000"] = <
					text = <"Alcohol consumptie overzicht">
					description = <"Overzicht van aanhoudende informatie over het typische alcoholgebruik van een individu.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Huidige drinker">
					description = <"Individu is een huidige drinker van alcohol.">
				>
				["at0005"] = <
					text = <"Ex-drinker">
					description = <"Individu heeft in het verleden alcohol geconsumeerd maar is geen huidige drinker.">
				>
				["at0006"] = <
					text = <"Levenslang niet-drinker">
					description = <"Individu heeft nooit alcohol gedronken.">
				>
				["at0013"] = <
					text = <"*Start date (en)">
					description = <"Datum waarop de episode begon.">
					comment = <"Kan een gedeeltelijke datum zijn, bijvoorbeeld een jaartal.">
				>
				["at0016"] = <
					text = <"Algemene stopdatum">
					description = <"De datum waarop het individu voor het laatst stopte met het drinken van alcohol van welk type dan ook.">
					comment = <"Kan een gedeeltelijke datum zijn, bijvoorbeeld een jaartal. Deze datum kan gebruikt worden in beslissingondersteuning om vast te stellen of het individu risico op terugval heeft, bijvoorbeeld in de eerste 12 maanden na het stoppen.">
				>
				["at0019"] = <
					text = <"Algemene opmerkingen">
					description = <"Aanvullende opmerkingen over alcohol consumptie die niet vastgelegd zijn in andere velden.">
				>
				["at0029"] = <
					text = <"Per type">
					description = <"Details over consumptie van een specifiek type alcohol.">
				>
				["at0030"] = <
					text = <"Patroon">
					description = <"Het typische patroon van alcohol consumptie.">
					comment = <"Het typische patroon kan in meer detail vastgelegd worden door te coderen met een terminologie of een lokale value set in een template.">
				>
				["at0043"] = <
					text = <"Algemene beschrijving">
					description = <"Verhalende samenvatting van het individu's algemene alcohol consumptie patroon en geschiedenis.">
					comment = <"Gebruik dit data element om een verhalende beschrijving van de alcoholgebruik gewoonten van dit individu vast te leggen of om ongestructureerde alcoholgebruik informatie uit bestaande of legacy systemen vast te leggen in een archetyped formaat.">
				>
				["at0052"] = <
					text = <"Status">
					description = <"Uitspraak over huidige alcohol consumptie gedrag.">
				>
				["at0053"] = <
					text = <"Beschrijving">
					description = <"Verhalende samenvatting over alcohol consumptie van het bepaalde type alcohol.">
				>
				["at0061"] = <
					text = <"Huidige drinker">
					description = <"Individu gebruikt alcohol tijdens deze periode.">
				>
				["at0064"] = <
					text = <"Per episode">
					description = <"Details over een discrete periode met een consistent patroon van typische consumptie.">
				>
				["at0069"] = <
					text = <"Opmerking">
					description = <"Aanvullende omschrijving over de consumptie van het specifieke type alcohol, indien niet vastgelegd in andere velden.">
				>
				["at0083"] = <
					text = <"Dagelijks">
					description = <"Consumeert alcoholische drank op zijn minst eenmaaldaags.">
				>
				["at0084"] = <
					text = <"Niet-dagelijks">
					description = <"Consumeert alcoholische dranken niet dagelijks.">
				>
				["at0087"] = <
					text = <"Episode opmerkingen">
					description = <"Aanvullende opmerkingen over alcohol consumptie tijdens deze episode, niet vastgelegd in andere velden.">
					comment = <"Bijvoorbeeld: alcohol gedronken als een remedie tegen een kater.">
				>
				["at0089"] = <
					text = <"Algemene status">
					description = <"Uitspraak over huidige consumptie van alle typen alcohol.">
				>
				["at0091"] = <
					text = <"NIet-drinker">
					description = <"Individu heeft geen alcohol gedronken tijdens deze episode.">
				>
				["at0097"] = <
					text = <"Overmatig drinken frequentie">
					description = <"De typische frequentie waarop het individu zwaar drinkt in een korte periode met de intentie om dronken te worden.">
				>
				["at0108"] = <
					text = <"Type">
					description = <"De naam van een specifiek type of groep van alcoholische drank.">
					comment = <"Gebruik bij voorkeur de gecodeerde tekst indien mogelijk. Als alternatief is het mogelijk om een lokale waardenset of terminologie te gebruiken voor het vastleggen van typen alcoholische dranken. Bijvoorbeeld: rode of witte wijn; brandewijn of whisky; normaal of laag-alcoholisch bier; of gedenatureerde alcohol (gemethyleerde spiritus) als een specifieke vorm van gedestileerde dranken.">
				>
				["at0110"] = <
					text = <"Alcoholvrije dagen">
					description = <"Het aantal dagen waarop geen alcohol was geconsumeerd in de bepaalde periode.">
				>
				["at0111"] = <
					text = <"*Typical consumption quantity (en)">
					description = <"*Estimate of number of standard drinks of the specified type of alcohol consumed. (en)">
					comment = <"De definitie van een alcohol eenheid kan vastgelegd worden in het Protocol.">
				>
				["at0112"] = <
					text = <"Episode beschrijving">
					description = <"Verhalende beschrijving over het individu's algemene alcohol consumptie patroon tijdens deze episode.">
					comment = <"Bijvoorbeeld: details over het patroon van overmatig drinken.">
				>
				["at0113"] = <
					text = <"Overmatig drinken beschrijving">
					description = <"Verhalende beschrijving over het individu's typische patroon van overmatig drinken.">
				>
				["at0115"] = <
					text = <"Bier">
					description = <"Gefermenteerde drank gemaakt van graanpuree.">
				>
				["at0116"] = <
					text = <"Wijn">
					description = <"Gefermenteerde drank gemaakt van druiven en soms andere vruchten.">
				>
				["at0117"] = <
					text = <"Cider">
					description = <"Gefermenteerde drank gemaakt van een vruchtensap.">
				>
				["at0118"] = <
					text = <"Mede">
					description = <"Gefermenteerde drank gemaakt van honing, soms met verscheidene vruchten, kruiden, granen of hop.">
				>
				["at0119"] = <
					text = <"Pulque">
					description = <"Gefermenteerde drank gemaakt van \"honingwater\" uit cacti.">
				>
				["at0120"] = <
					text = <"Gedestileerde dranken">
					description = <"Gefermenteerde drank gemaakt door een destilatieproces. Heeft doorgaans een alcoholgehalte >20%. Dit omvat likeuren, cocktails en gedenatureerde alcohol.">
				>
				["at0121"] = <
					text = <"Versterkte wijn">
					description = <"Wijn met toegevoegde gedestileerde drank.">
				>
			>
		>
	>
