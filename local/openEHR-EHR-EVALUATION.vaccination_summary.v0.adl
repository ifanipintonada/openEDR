description
	original_author = <
		["date"] = <"2012-11-23">
		["name"] = <"Heather Leslie">
		["organisation"] = <"Atomica Informatics">
		["email"] = <"heather.leslie@atomicainformatics.com">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Silje Ljosland Bakke, Nasjonal IKT HF, Norway (openEHR Editor)","Sistine Barretto-Daniels, Ocean Informatics, Australia","Merrilyn Curtis, AnalyzeIT, Australia","Heather Leslie, Atomica Informatics, Australia (openEHR Editor)","Ian McNicoll, freshEHR Clinical Informatics, United Kingdom (openEHR Editor)">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Aufzeichnung einer Zusammenfassung von Impfstoffverabreichungsereignissen, die auf eine einzelne Infektionskrankheit oder einen einzelnen Erreger oder eine Gruppe von Infektionskrankheiten oder Erregern abzielen, die gleichzeitig mit einem Kombinationsimpfstoff geimpft werden.">
			keywords = <"Immunisierung","Impfung","Schutzimpfung","Immunstatus","Zusammenfassung","primär","Erstimpfung","Auffrischung">
			use = <"Zur Aufzeichnung einer Zusammenfassung von Impfstoffverabreichungen gegen eine einzelne Infektionskrankheit oder einen Erreger oder gegen eine Gruppe von Infektionskrankheiten oder Erregern, die gleichzeitig mit einem Kombinationsimpfstoff geimpft werden.

Der Zweck dieses Archetyps besteht darin, eine klinische Beurteilung zu ermöglichen, ob die Person auf dem aktuellsten Stand der Immunisierungsmaßnahmen gegen die betreffende(n) Krankheit(en) oder Erreger ist. Es soll keine Aussage über den Immunisierungsstatus getroffen werden, d. h. darüber, ob die Person nach der Impfung eine angemessene Immunantwort entwickelt hat oder ob die schützende Immunität nachgelassen hat. 

Dieser Archetyp geht nicht von einem bestimmten Zeitplan oder Protokoll für die Immunisierung aus.">
			misuse = <"Nicht für die Erfassung des Impfstatus einer Person zu einem bestimmten Zeitpunkt zu verwenden - verwenden Sie zu diesem Zweck OBSERVATION.vaccination_status. 

Nicht zu verwenden für die Dokumentation der detaillierten Verabreichung eines Impfstoffs, einschließlich Körperstelle, Verabreichungsweg, Hersteller und Chargennummer usw. - verwenden Sie zu diesem Zweck ACTION.vaccination oder ACTION.medication.

Nicht zu verwenden für die Aufzeichnung von Screening-Frage/Antwort-Paaren zur Impftätigkeit - verwenden Sie zu diesem Zweck OBSERVATION.vaccination_screening.">
		>
		["es-ar"] = <
			language = <[ISO_639-1::es-ar]>
			purpose = <"*To record a summary of vaccine administration events targeting a single infectious disease or agent, or a group of infectious diseases or agents that are vaccinated simultaneously using a combination vaccine. (en)">
			keywords = <"vacunación","inmunización","resumen","primario","ciclo","refuerzo">
			copyright = <"© openEHR Foundation">
			use = <"*Use to record a summary of vaccine administration events targeting a single infectious disease or agent, or a group of infectious diseases or agents that are vaccinated simultaneously using a combination vaccine.

The intent of this archetype is to support a clinical determination about whether the individual is up-to-date with vaccinations for the targeted disease/s or agent/s. It is not intended to make a determination about the immunisation status, which is about whether the individual has developed an adequate immune response following vaccination or whether protective immunity has waned. 

This archetype does not presume any particular schedule or protocol for immunisation. (en)">
			misuse = <"*Not to be used to record the vaccination status of an individual at a point in time - use OBSERVATION.vaccination_status for this purpose. 

Not to be used for documenting the detailed administration of a vaccine, including body site, route, manufacturer and batch number etc - use ACTION.vaccination or ACTION.medication for this purpose.

Not to be used for recording screening question/answer pairs regarding vaccination activity - use OBSERVATION.vaccination_screening for this purpose. (en)">
		>
		["pt-br"] = <
			language = <[ISO_639-1::pt-br]>
			purpose = <"*To record a summary of vaccine administration events targeting a single infectious disease or agent, or a group of infectious diseases or agents that are vaccinated simultaneously using a combination vaccine. (en)">
			keywords = <"vacinação","imunização","sumário","primário","etapa","reforço">
			copyright = <"© openEHR Foundation">
			use = <"*Use to record a summary of vaccine administration events targeting a single infectious disease or agent, or a group of infectious diseases or agents that are vaccinated simultaneously using a combination vaccine.

The intent of this archetype is to support a clinical determination about whether the individual is up-to-date with vaccinations for the targeted disease/s or agent/s. It is not intended to make a determination about the immunisation status, which is about whether the individual has developed an adequate immune response following vaccination or whether protective immunity has waned. 

This archetype does not presume any particular schedule or protocol for immunisation. (en)">
			misuse = <"*Not to be used to record the vaccination status of an individual at a point in time - use OBSERVATION.vaccination_status for this purpose. 

Not to be used for documenting the detailed administration of a vaccine, including body site, route, manufacturer and batch number etc - use ACTION.vaccination or ACTION.medication for this purpose.

Not to be used for recording screening question/answer pairs regarding vaccination activity - use OBSERVATION.vaccination_screening for this purpose. (en)">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a summary of vaccine administration events targeting a single infectious disease or agent, or a group of infectious diseases or agents that are vaccinated simultaneously using a combination vaccine.">
			keywords = <"immunisation","immunisation","immunization","summary","primary","course","booster">
			copyright = <"© openEHR Foundation">
			use = <"Use to record a summary of vaccine administration events targeting a single infectious disease or agent, or a group of infectious diseases or agents that are vaccinated simultaneously using a combination vaccine.

The intent of this archetype is to support a clinical determination about whether the individual is up-to-date with vaccinations for the targeted disease/s or agent/s. It is not intended to make a determination about the immunisation status, which is about whether the individual has developed an adequate immune response following vaccination or whether protective immunity has waned. 

This archetype does not presume any particular schedule or protocol for immunisation.">
			misuse = <"Not to be used to record the vaccination status of an individual at a point in time - use OBSERVATION.vaccination_status for this purpose. 

Not to be used for documenting the detailed administration of a vaccine, including body site, route, manufacturer and batch number etc - use ACTION.vaccination or ACTION.medication for this purpose.

Not to be used for recording screening question/answer pairs regarding vaccination activity - use OBSERVATION.vaccination_screening for this purpose.">
		>
	>
