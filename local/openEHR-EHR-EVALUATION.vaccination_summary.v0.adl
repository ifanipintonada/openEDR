				["at0052"] = <
					text = <"Name des Impfstoffes">
					description = <"Name des verabreichten Impfstoffes">
					comment = <"Der Name des Impfstoffs kann einen generischen oder Handelsnamen für einen Impfstoff, den Namen eines Kombinationsimpfstoffs oder eine Kategorie von Impfstoffen enthalten. Zum Beispiel: Masern-Impfstoff; Masern-Mumps-Röteln (MMR) oder \"Masern-haltiger Impfstoff\". Die Kodierung mit einer externen Terminologie wird, wenn möglich, bevorzugt.">
