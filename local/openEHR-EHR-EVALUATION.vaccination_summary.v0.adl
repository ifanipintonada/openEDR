		["de"] = <
			items = <
				["at0000"] = <
					text = <"Zusammenfassung der Impfungen">
					description = <"Zusammenfassung der Verabreichung von Impfungen gegen eine einzelne Infektionskrankheit oder einen einzelnen Erreger oder eine Gruppe von Infektionskrankheiten oder Erregern, die gleichzeitig mit einem Kombinationsimpfstoff geimpft werden.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Gezielte Krankheit oder Erreger">
					description = <"Name der Infektionskrankheit oder des Erregers, gegen den der Impfstoff wirkt.">
					comment = <"Handelt es sich bei dem \"Impfstoffnamen\" um einen Kombinationsimpfstoff, kann dieses Datenelement mehr als eine Zielkrankheit enthalten. Die Kodierung mit einer externen Terminologie wird, wenn möglich, bevorzugt.">
				>
				["at0009"] = <
					text = <"Datum der letzten Impfung">
					description = <"Das Datum, an dem der letzte Impfstoff verabreicht wurde.">
					comment = <"Kann ein Teildatum sein, zum Beispiel nur ein Jahr.">
				>
				["at0022"] = <
					text = <"Pro Impfstoffverabreichung">
					description = <"Details zu einer bestimmten Impfstoffverabreichung.">
				>
				["at0024"] = <
					text = <"Verabreichungsdatum">
					description = <"Datum der Verabreichung des angegebenen Impfstoffs.">
					comment = <"Kann ein Teildatum sein, beispielsweise nur ein Jahr.">
				>
				["at0031"] = <
					text = <"Reihenfolge der Mehrfachimpfung">
					description = <"Die Reihenfolge der verabreichten Impfstoffe innerhalb einer Grundimmunisierung oder einer Mehrfachimpfung.">
					comment = <"Zum Beispiel: 1/2 für die erste Impfung bei einer Mehrfachimpfung.">
				>
				["at0033"] = <
					text = <"Nächste Impfung fällig">
					description = <"Das Datum, an dem die nächste Impfung verabreicht werden soll.">
				>
				["at0034"] = <
					text = <"Details zum Impfstoff">
					description = <"Einzelheiten zum Impfstoff, einschließlich generischer Komponenten und Chargennummer, falls erforderlich.">
				>
				["at0035"] = <
					text = <"Beschreibung">
					description = <"Beschreibung der Impfmaßnahmen und Erfahrungen im Zusammenhang mit der betreffenden Krankheit oder dem betreffenden Erreger.">
				>
				["at0038"] = <
					text = <"Verabreichungskategorie">
					description = <"Kategorie des verabreichten Impfstoffs.">
					comment = <"Zum Beispiel: Grundimmunisierung; oder Booster.">
				>
				["at0039"] = <
					text = <"Grundimpfung">
					description = <"">
				>
				["at0040"] = <
