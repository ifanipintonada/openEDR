				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Prøvemateriale">
					description = <"Et fysisk prøvemateriale tatt fra eller relatert til et individ, for undersøkelse eller analyse.">
					comment = <"For eksempel kroppsvev eller kroppsvæske.">
				>
				["at0001"] = <
					text = <"Laboratoriets identifikator">
					description = <"En unik identifikator av prøvematerialet, som regel tilordnet av laboratoriet.">
					comment = <"I noen sammenhenger, som HL7 og IHE, kalt \"Accession Identifier\", mens et norsk synonym er \"Prøvenummer\". Prøvebeholdere, for eksempel vakuumglass eller vevskassetter, har egne IDer som registreres i elementet \"BeholderID\" i arketypen Prøvebeholder.">
				>
				["at0005"] = <
					text = <"Risikovarsel">
					description = <"Identifisert helserisiko eller biologisk risiko for prøvetakeren eller laboratoriepersonell ved eksponering for eller kontakt med prøvematerialet.">
					comment = <"For eksempel \"Hepatitt B\" eller \"nervegift\". Koding av Risikovarsel med en terminologi er foretrukket, der det er mulig.">
				>
				["at0007"] = <
					text = <"Prøvetakingsmetode">
					description = <"Prøvetakingsmetoden som er brukt.">
					comment = <"For eksempel venepunksjon, biopsi eller reseksjon. Koding av prøvetakingsmetoden med en terminologi er foretrukket, når det er mulig. Dersom prøvetakingsmetoden er inkludert i \"Type prøvemateriale\" gjennom bruk av prekoordinerte koder blir dette elementet overflødig.">
				>
				["at0008"] = <
					text = <"Prøvetakingsforhold">
					description = <"Forhold under prøvetaking.">
					comment = <"For eksempel \"fastende\", \"full blære\", \"sterilt felt\" eller en hvilken som helst instruksjon om håndtering eller umiddelbar prosessering av prøvematerialet, for eksempel \"sentrifugeres umiddelbart etter mottak\". Dette dataelementet kan også brukes for å dokumentere kjente avvik fra prøvetakings- eller håndteringsinstruksjoner, for eksempel at pasienten ikke var fastende til tross for at dette var forordnet. Koding av prøvetakingsforholdene med en terminologi foretrekkes, der det er mulig.

Hvis denne arketypen brukes innenfor en INSTRUCTION-arketype, vil dette elementet reflektere ønskede eller forordnede forhold ved prøvetakingen. Hvis arketypen brukes innenfor en ACTION-arketype et prosesstrinn som medfører at prøvetakingen er under uføring eller er utført, vil dette elementet reflektere forhold som faktisk var tilstede ved prøvetakingen. Dette kan også kopieres til elementet \"Konfunderende faktorer\" i arketypen OBSERVATION.laboratory_test_result.">
				>
				["at0013"] = <
					text = <"Strukturert anatomisk lokalisering">
					description = <"En strukturert anatomisk lokalisering der prøvematerialet ble tatt fra.">
					comment = <"Bruk de mer detaljerte arketypene for å beskrive strukturerte eller mer komplekse anatomiske steder, eller for å støtte at applikasjonen kan registrere lokaliseringen. Dersom den anatomiske lokaliseringen er med i \"Type prøvemateriale\" via prekoordinerte koder, blir dette SLOTet overflødig.">
				>
				["at0015"] = <
					text = <"Dato/tid for prøvetaking">
					description = <"Dato og tid for når prøvetakingen skal skje, eller har skjedd.">
					comment = <"Denne dato/tidsregistreringen vil primært registreres i forbindelse med INSTRUCTION-timing, ACTION-tid, eller OBSERVATION-tider. Imidlertid er dette en kritisk informasjonsbit, og det kan være nyttig å ha mulighet til å også knytte den direkte til prøvematerialet.">
				>
				["at0027"] = <
					text = <"Fysiske egenskaper">
					description = <"Fysiske dimensjoner, masse eller ikke-målbare egenskaper ved prøvematerialet.">
					comment = <"For eksempel volum, masse, omkrets, farge, lukt, turbiditet. Dette elementet kan brukes for å angi egenskapene ved prøvematerialet som skal innhentes, i konteksten av en INSTRUCTION-arketype, eller egenskapene ved prøvematerialet som ble innhentet, i konteksten av en ACTION- eller OBSERVATION-arketype. For eksempel kan det i en INSTRUCTION bestilles innhenting av 20 ml blod, mens det i den korresponderende ACTION-arketypen registreres at bare 15 ml ble innhentet.">
				>
				["at0029"] = <
					text = <"Type prøvemateriale">
					description = <"Type prøvemateriale.">
					comment = <"For eksempel venøst blod, bakteriekultur, celleprøve eller vevsprøve. Koding av prøvetypen med en terminologi er foretrukket, dersom mulig.">
				>
				["at0034"] = <
					text = <"Dato/tid for mottak">
					description = <"Datoen og klokkeslettet da prøven ble mottatt på laboratoriet.">
				>
				["at0045"] = <
					text = <"Kommentar">
					description = <"Ytterligere fritekst om prøvematerialet som ikke dekkes av andre felt.">
				>
				["at0067"] = <
					text = <"Prøvetakingsomgivelser">
					description = <"Den fysiske situasjonen der prøvematerialet ble innhentet.">
					comment = <"For eksempel laboratorieprøvemottak, i hjemmet, eller sengepost. Dette elementet spesifiserer typen omgivelser prøvematerialet ble tatt i. Prøvetakingssituasjonen kan også gi ytterligere informasjon som er relevant for tolkningen av resultatet.">
				>
				["at0079"] = <
					text = <"Beskrivelse av prøvetaking">
					description = <"Fritekstbeskrivelse av prøvetakingen. Dette elementet kalles i noen sammenhenger også \"Prøvetakers kommentar\".">
				>
				["at0080"] = <
					text = <"Antall beholdere">
					description = <"Det totale antallet fysiske enheter som prøvematerialet er fordelt på.">
					comment = <"For eksempel antall bøtter, glass, rør, mikrorør, blokker, prøveglass eller grid.">
				>
				["at0085"] = <
					text = <"Detaljer om beholder">
					description = <"Detaljer om brukte beholdere.">
				>
				["at0087"] = <
					text = <"Opprinnelsessted">
					description = <"Kroppssted eller annen lokalisering som prøven er tatt fra.">
					comment = <"For eksempel \"sår på venstre legg\", \"venekateter på høyre arm\", \"høyre nyre\".
Koding av den anatomiske lokaliseringen med en terminologi er foretrukket der det er mulig. Bruk dette dataelementet til å registrere prekoordinerte anatomiske lokaliseringer. Dersom behovene for registrering av den anatomiske lokaliseringen bestemmes i applikasjonen eller krever kompleks modellering slik som relative lokaliseringer, bruk SLOTet \"Strukturert anatomisk lokalisering\" i denne arketypen. Dersom den anatomiske lokaliseringen er med i \"Type prøvemateriale\" via prekoordinerte koder, blir dette dataelementet overflødig.">
				>
				["at0096"] = <
					text = <"Digital representasjon">
					description = <"Strukturerte detaljer om en digital representasjon av prøvematerialet.">
					comment = <"For eksempel et scannet bilde av et prøveglass innen patologi.">
				>
				["at0097"] = <
					text = <"Prøvemateriale beskrivelse">
					description = <"Fritekstbeskrivelse av prøvematerialet som blir undersøkt.">
					comment = <"For eksempel: fargen og viskositeten til en væske; formen til et solid vev; eller en beskrivelse av vevsfragmenter.">
				>
				["at0098"] = <
					text = <"Prøvemateriale navn">
					description = <"Et navn eller etikett som beskriver prøvematerialet.">
					comment = <"Vanligvis kun relevant for anatomiske patologiprøver. For eksempel: 'Sigmoidreseksjon med et stykke blærevegg' eller 'Aggregat av flere hudbiopsifragmenter'">
				>
			>
		>
		["de"] = <
			items = <
				["at0000"] = <
					text = <"Probe">
					description = <"Eine physikalische Probe zur Prüfung, Untersuchung oder Analyse, die von einer Person entnommen wurde oder die sich auf die Person bezieht.">
					comment = <"Zum Beispiel: Gewebe oder Körperflüssigkeit.">
				>
				["at0001"] = <
					text = <"Laborprobenidentifikator">
					description = <"Eine eindeutige Kennung der Probe, die normalerweise vom Labor vergeben wird.">
					comment = <"Wird manchmal als \"Accession Identifier\" bezeichnet. Probenbehälter, z. B. Vakuumröhrchen oder Gewebekassetten, haben ihre eigenen Kennungen, die im Element \"Behälter-Identifikator\" des Archetyps \"Probenbehälter\" eingetragen werden können.">
					fhir_mapping = <"Specimen.accessionIdentifier">
				>
				["at0005"] = <
					text = <"Gefahrenhinweis">
					description = <"Jegliches Risiko oder jede Biogefährdung für den Probenehmer oder das Laborpersonal aufgrund der Exposition gegenüber oder Kontakt mit der Probe.
">
					comment = <"Zum Beispiel: \"Hepatitis B\"; \"Nervenmittel\". Die Codierung des \"Gefahrenhinweises\" mit einer Terminologie wird, wenn möglich, bevorzugt.">
				>
				["at0007"] = <
					text = <"Probenentnahmemethode">
					description = <"Die Methode der Probenentnahme, die angewendet wird oder wurde.">
					comment = <"Zum Beispiel: Venenpunktion, Biopsie, Resektion. Nach Möglichkeit wird die Codierung der Probenentnahmemethode mit einer Terminologie bevorzugt. Wenn die Probenentnahmemethode über vorkoordinierte Codes in das Element \"Probenart\" einbezogen wird, wird dieses Datenelement überflüssig.">
					fhir_mapping = <"Specimen.collection.method">
				>
				["at0008"] = <
					text = <"Probenentahmebedingung">
					description = <"Der Kontext, in dem die Probe entnommen wird.">
					comment = <"Zum Beispiel: \"Fasten\", \"volle Blase\", \"steriles Feld\" oder spezielle Anweisungen zur Handhabung oder sofortigen Verarbeitung der Probe, zum Beispiel \"Nach Erhalt zentrifugieren\". Kann auch verwendet werden, um bekannte Abweichungen von Entnahme- oder Handhabungsanweisungen zu dokumentieren, z.B. dass der Patient nicht gefastet hat. Wenn möglich, wird eine Kodierung der Probenentahmebedingung mit einer Terminologie bevorzugt. 

Ob dieses Element Bedingungen enthält, die während der Probeentnahme vorhanden sein sollten oder waren, hängt vom Kontext des Container-Archetyps ab, in der Regel ein INSTRUCTION-Archetyp. Der Inhalt dieses Elements im Kontext eines ACTION-Archetyps in einem abgeschlossenen Zustand kann verwendet werden, um zu entscheiden, ob signifikante Störfaktoren im Zusammenhang mit der Entnahme aufgetreten sind, die zum einpflegen des Elements \"Störfaktoren\" des Archetyps OBSERVATION.laboratory_test_result verwendet werden können.">
				>
				["at0013"] = <
					text = <"Probenentnahmestelle strukturiert">
					description = <"Strukturierte Angaben zur Körperstelle, an der die Probe entnommen wurde.">
					comment = <"Verwenden Sie diesen Archetypen zur Beschreibung strukturierter oder komplexerer anatomischen Stellen oder zur Unterstützung der Darstellung der Entnahmestelle während der Anwendung. Wenn die Körperstelle über vorab koordinierte Codes in das Element \"Probenentnahmestelle\" einbezogen wird, wird die Verwendung dieses SLOTs überflüssig.">
					fhir_mapping = <"Specimen.collection.bodySite">
				>
				["at0015"] = <
					text = <"Zeitpunkt der Probenentnahme">
					description = <"Das Datum und die Uhrzeit, zu der die Probennahme angeordnet wurde oder stattfand.">
					comment = <"Dieser Zeitpunkt wird hauptsächlich in den Zeitangaben, von INSTRUCTION, ACTION oder OBSERVATION erfasst. Da es sich jedoch um eine wichtige Information handelt, kann es nützlich sein, diese auch direkt mit der Probe selbst zu verknüpfen.">
				>
				["at0027"] = <
					text = <"Physikalische Eigenschaften">
					description = <"Physikalische Größen, Masse oder nicht messbare Eigenschaften der Probe.">
					comment = <"Zum Beispiel: Volumen, Masse, Umfang, Farbe, Geruch, Trübung. Mit diesem Element können die Eigenschaften der zu entnehmenden Probe im Kontext eines INSTRUCTION-Archetyps oder die Eigenschaften der zu entnehmenden Probe im Kontext eines ACTION- oder OBSERVATION-Archetyps angegeben werden. Beispielsweise kann eine INSTRUCTION die Entnahme von 20 ml Blut verlangen, während die entsprechende ACTION aufzeichnet, dass nur 15 ml entnommen wurden.">
					fhir_mapping = <"Specimen.collection.quantity">
				>
				["at0029"] = <
					text = <"Probenart">
					description = <"Die Art der Probe.">
					comment = <"Zum Beispiel: Venöses Blut, Bakterienkultur, Zytologie oder Gewebeprobe. Nach Möglichkeit wird die Codierung der Probenart mit einer Terminologie bevorzugt.">
					fhir_mapping = <"Specimen.type">
				>
				["at0034"] = <
					text = <"Zeitpunkt des Probeneingangs">
					description = <"Datum und Uhrzeit des Eingangs der Probe im Labor.">
					fhir_mapping = <"Specimen.receivedTime">
				>
				["at0045"] = <
					text = <"Kommentar">
					description = <"Zusätzliche Beschreibungen der Probe, die nicht in anderen Feldern abgebildet werden können.">
					fhir_mapping = <"Specimen.note">
				>
				["at0067"] = <
					text = <"Umgebung der Probenentnahme">
					description = <"Identifizierung der physikalischen Umgebung, in der die Probe entnommen wird.">
					comment = <"Zum Beispiel: Laborambulanz, zu Hause oder Krankenhausstation. Dies gibt den Ort der Probenentnahme im Gesundheitswesen an. Auf diese Weise kann das Labor bei Bedarf Fragen zur Entnahme der Probe stellen. Die Vorgabe zur Probenentnahme kann zusätzliche Informationen enthalten, die für die Analyse des Ergebnisses relevant sind.">
				>
				["at0079"] = <
					text = <"Beschreibung der Entnahme">
					description = <"Beschreibung der Probenentnahme.">
				>
				["at0080"] = <
					text = <"Anzahl der Behälter">
					description = <"Die Gesamtzahl der physischen Einheiten, in denen sich die Probe befindet.">
					comment = <"Zum Beispiel: Anzahl der Behälter, Gefäße, Fläschchen, Röhrchen, Blöcke, Objektträger oder Gitter.">
				>
				["at0085"] = <
					text = <"Behälter Details">
					description = <"Details über Behälter, der/die verwendet wurde/n.">
				>
				["at0087"] = <
					text = <"Probenentnahmestelle">
					description = <"Identifizierung der Körperstelle oder einer anderen Stelle, an der die Probe entnommen wird.">
					comment = <"Zum Beispiel: „Wunde an linker Wade“, „IV-Kanüle rechter Arm“, „rechte Niere“. 
Nach Möglichkeit wird die Codierung des Namens der Probenentnahmestelle mit einer Terminologie bevorzugt. Verwenden Sie dieses Datenelement, um vorkoordinierte Probenentnahmestellen zu erfassen. Wenn die Anforderungen für die Darstellung der Probenentnahmestelle zur Laufzeit der Anwendung bestimmt werden oder diese eine komplexere Modellierung erfordern, z.B. relative Positionen, verwenden Sie in diesem Archetyp den SLOT \"Probenentnahmestelle strukturiert\". Wenn die Probenentnahmestelle über vorab koordinierte Kodes in das Element \"Probenart\" einbezogen wird, wird dieses Datenelement überflüssig.">
				>
				["at0096"] = <
					text = <"Digitale Darstellung">
					description = <"Strukturierte Details über eine digitale Darstellung der Probe.">
					comment = <"Zum Beispiel das gescannte Bild eines Histopathologie-Dias.">
				>
				["at0097"] = <
					text = <"Beschreibung der Probe">
					description = <"Beschreibung der untersuchten Probe.">
					comment = <"Zum Beispiel: die Farbe und Viskosität einer Flüssigkeit, die Form eines festen Gewebes oder eine Beschreibung von Gewebefragmenten.">
				>
				["at0098"] = <
					text = <"Probenbezeichnung">
					description = <"Ein Name oder Label, der/das die Probe beschreibt.">
					comment = <"Normalerweise nur für anatomisch-pathologische Proben relevant. Zum Beispiel: „Sigmoidresektion mit einem Stück Blasenwand“ oder „Aggregat mehrerer Hautbiopsiefragmente“.">
				>
			>
		>
		["sv"] = <
			items = <
				["at0000"] = <
					text = <"Provmaterial">
					description = <"Ett fysiskt prov/provmaterial taget från, eller relaterat till, en individ i syfte att utföra en bedömning, undersökning eller analys.">
					comment = <"Exempelvis vävnad eller kroppsvätska.">
				>
				["at0001"] = <
					text = <"Laboritoriets providentifierare">
					description = <"En unik providentifierare, vanligen angiven av laboratoriet.">
					comment = <"Syftet är identifiering av ett prov i laboratorieinformationssystemet. Provbehållare såsom exempelvis vakuumflaskor och vävnadskassetter har sina egna ID-nummer vilka kan anges i \"Container-elementet\" i arketyper Specimen Container.

">
				>
				["at0005"] = <
					text = <"Riskvarning">
					description = <"Identifierad hälsofara eller biologisk fara för provtagaren eller laboratoriepersonalen vid exponering för eller kontakt med provmaterialet.">
					comment = <"Till exempel \"hepatit B\" eller \"nervmedel\". Kodning av riskvarning med en terminologi är att föredra, där det är möjligt.
">
				>
				["at0007"] = <
					text = <"Provtagningsmetod">
					description = <"Den metod som används för att ta provet.">
					comment = <"Exempelvis venpunktion, biopsi eller resektion. Kodning av provtagningsmetod till en terminologi är att föredra i de fall det är möjligt. Om provtagningsmetoden inkluderas i \"Provtyp\" via prekoordinerade koder blir detta dataelement redundant. 
">
				>
				["at0008"] = <
					text = <"Provtagningskontext">
					description = <"Den kontext i vilken provet togs.">
					comment = <"Exempel: fastande, full urinblåsa, sterilt fält. Alternativt specialinstruktioner avseende hanteringen av provet eller omedelbar beredning av provet såsom \"centrifugera vid mottagande\". Det här dataelementet kan även användas för att dokumentera olika typer av kända avvikelser vid provtagning eller hanteringsinstruktioner såsom exempelvis att patienten inte hade fastat trots att det uttryckligen hade begärts. Kodning av provtagningskontexten till en terminologi är att föredra i de fall det är möjligt. 

Om den här arketypen används i en annan arketyp av typen INSTRUCTION kommer kontexten att återspegla de avsedda eller önskade förhållandena under provtagningen.

Om den arketypen används för att representera ett steg i en arketyp av typen ACTION som härrör till att provtagningen utförs eller slutförs kommer kontexten att återspegla de förhållanden som fanns vid provtagningen och detta kan även kopieras till elementet \"Möjliga felkällor\" i arketypen OBSERVATION.laboratory_test_result archetype.
">
				>
				["at0013"] = <
					text = <"Strukturerad anatomisk lokalisation">
					description = <"En strukturerad beskrivning av den anatomiska plats från vilken provet togs.
">
					comment = <"Använd de mer detaljerade arketyperna för att beskriva strukturerade eller mer komplexa anatomiska platser, eller för att stödja applikationen för att upptäcka platsen. Om den anatomiska platsen ingår i \"Provkälla\" via förkoordinerade koder blir denna SLOT överflödig.
">
				>
				["at0015"] = <
					text = <"Datum/tid för provtagning">
					description = <"Datum och tid för när provtagningen ska äga rum eller har ägt rum.">
					comment = <"Datum/tid kommer främst att anges i arketyper av typerna INSTRUCTION, ACTION eller OBSERVATION. Detta är dock en kritisk informationsdel och därför det kan vara användbart att ha möjlighet att också länka den direkt till provmaterialet.

">
				>
				["at0027"] = <
					text = <"Fysiska egenskaper">
					description = <"Provmaterialets fysiska dimensioner, massa eller icke mätbara egenskaper.">
					comment = <"Till exempel: Volym, massa, omkrets, färg, lukt eller turbiditet. Detta dataelement kan användas i en arketyp av typen INSTRUCTION för att specificera egenskaperna hos ett provmaterial som ska samlas in, alternativt i en arketyp av typen ACTION eller OBSERVATION för att ange egenskaper hos ett provmaterial som redan har samlats in.">
					fhir_mapping = <"Specimen.collection.quantity">
				>
				["at0029"] = <
					text = <"Provtyp">
					description = <"Typ av prov">
					comment = <"Exempelvis venöst blod, bakteriekultur, cytologi eller vävnadsprov. Kodning av provtypen till en terminologi är att föredra i de fall det är möjligt.">
				>
				["at0034"] = <
					text = <"Datum/tid ankomst till labb">
					description = <"Datum och tid när provet togs emot av laboratoriet.">
				>
				["at0045"] = <
					text = <"Kommentar">
					description = <"Ytterligare fritext om provmaterialet som inte omfattas av andra fält.">
				>
				["at0067"] = <
					text = <"Provtagningsmiljö">
					description = <"Den fysiska miljös i vilken provmaterialet samlades in.">
					comment = <"Till exempel: Laboratoriets öppenvårdsmottagning, hemma eller sjukhusavdelning. Detta dataelement specificerar i vilken typ av miljö provmaterialet samlades in. Provtagningssituationen kan också ge ytterligare information som är relevant för tolkningen av resultatet.
">
				>
				["at0079"] = <
					text = <"Beskrivning av provtagning">
					description = <"Fritextbeskrivning av provtagningen.">
				>
				["at0080"] = <
					text = <"Antal behållare">
					description = <"Det totala antalet fysiska enheter som provmaterialet är distribuerat i. 
">
					comment = <"Till exempel: antal provbehållare, provrör, provflaskor, block, objektglas eller galler.

">
				>
				["at0085"] = <
					text = <"Detaljer om provbehållare">
					description = <"Detaljer om provbehållare som har använts.">
				>
				["at0087"] = <
					text = <"Provkälla">
					description = <"Identifiering av var på kroppen eller annat ställe som provet är taget från.
">
					comment = <"Exempelvis \"sår på vänster underben\", \"venkateter på höger arm\", \"höger njure\". Kodning av provkälla till en terminologi är att föredra i de fall det är möjligt.

Använd detta dataelement för att ange prekoordinerade provkällor. Om behoven för registrering av den anatomiska platsen bestäms i applikationen eller kräver komplex modellering såsom relativa platser, använd SLOT \"Strukturerad anatomisk lokalisation\" i denna arketyp. Om den anatomiska platsen ingår i \"Provtyp\" via förkoordinerade koder blir detta dataelement överflödigt.
">
				>
				["at0096"] = <
					text = <"Digital representation">
					description = <"Strukturerade detaljer om digital representation av provmaterialet.">
					comment = <"Till exempel den skannade bilden av en histopatologibild.
">
				>
				["at0097"] = <
					text = <"Provbeskrivning">
					description = <"Berättande beskrivning av det prov som undersöks.">
					comment = <"Till exempel: färgen och viskositeten hos en vätska; formen av en fast vävnad; eller en beskrivning av vävnadsfragment.
">
				>
				["at0098"] = <
					text = <"Provets benämning">
					description = <"Namn eller etikett som beskriver provet">
					comment = <"Vanligtvis endast relevant för anatomiska patologiprover. Till exempel: 'Sigmoid resektion med en bit av blåsväggen' eller 'Aggregering av flera hudbiopsifragment'.">
				>
			>
		>
	>
	term_binding = <
		["LOINC"] = <
			items = <
				["at0000"] = <[LOINC::66746-9]>
			>
		>
	>
	constraint_binding = <
		["LOINC"] = <
			items = <
				["ac0000"] = <terminology:http://loinc.org&code=66746-9>
			>
		>
	>
